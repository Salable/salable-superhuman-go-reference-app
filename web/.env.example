# --- Application ---------------------------------------------------------
# Public origin of this deployment (no trailing slash).
APP_URL=https://your-app.vercel.app
# Postgres connection string (Neon via Vercel, or local docker-compose).
DATABASE_URL=postgresql://postgres:postgres@localhost:5439/snippet_vault
# Secret for signing upgrade/account links handed out in chat. Any long random string.
LINK_SECRET=change-me-to-a-long-random-string
# Free-tier monthly save allowance.
FREE_SNIPPET_ALLOWANCE=10
# How long the server-side entitlement cache lives between Salable checks.
ENTITLEMENT_CACHE_TTL_SECONDS=60

# --- Salable (test mode) -------------------------------------------------
SALABLE_API_BASE=https://salable.app
# Secret API key — server-side only.
SALABLE_API_KEY=sk_test_...
# Publishable API key — used for the Path 1 relay (client-safe check).
SALABLE_PUBLISHABLE_KEY=pk_test_...
# Produced by `npm run seed:salable`.
SALABLE_PRO_PLAN_ID=
# Meter slug the seed script provisions on the Pro plan.
SALABLE_METER_SLUG=snippet_saves
# Signing secret of the webhook destination pointing at /api/webhooks/salable.
SALABLE_WEBHOOK_SECRET=

# --- Superhuman Go OAuth client ------------------------------------------
# Set the same client ID/secret in the Pack's "Add OAuth Credentials" dialog.
SHGO_OAUTH_CLIENT_ID=superhuman-go
SHGO_OAUTH_CLIENT_SECRET=change-me-to-a-long-random-string
# Comma-separated allowlist. Superhuman shows the exact redirect URL in the
# OAuth credentials dialog; it follows this pattern (plus legacy coda.io forms):
SHGO_OAUTH_REDIRECT_URIS=https://docs.superhuman.com/packsAuth/oauth2/YOUR_PACK_ID
